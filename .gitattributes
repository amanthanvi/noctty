#--------------------------------------------------------------------
# Line endings
#--------------------------------------------------------------------
# Source code - always LF
*.zig text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.m text eol=lf
*.swift text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.glsl text eol=lf
*.blp text eol=lf

# Config/build files - always LF
.gitattributes text eol=lf
flake.lock text eol=lf
*.zon text eol=lf
*.nix text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
Makefile text eol=lf

# Text data files - always LF (embedded in Zig, parsed with \n split)
*.txt text eol=lf
src/terminal/testdata/replay/*.vt text eol=lf

# Files the build embeds (@embedFile) or ships as they are - always LF.
# `core.autocrlf=true` (Git for Windows' default) checks out any text file that
# is not pinned as CRLF, so a build from such a checkout, which the release
# job's checkout evidently was, put CRLF bytes into noctty.exe's first-run config
# template and into the bash, zsh, fish, nushell, elvish and Clink integration
# scripts of the release package (measured on v1.3.131). A strict bash rejects
# a CR (WSL's `bash -n` fails on the shipped ghostty.bash); Git Bash tolerates it.
src/config/config-template text eol=lf
src/config/testdata/* text eol=lf
src/shell-integration/** text eol=lf
src/font/res/*.bdf text eol=lf
# The D3D11 shader source: terminal_bytecode.h records its SHA-256, and a test
# compares that against the checked-out bytes, so a CRLF checkout must not differ.
src/renderer/d3d11/*.hlsl text eol=lf

# Static site sources - always LF
site/*.html text eol=lf
site/*.css text eol=lf
site/*.js text eol=lf
site/_headers text eol=lf
site/assets/*.svg text eol=lf
site/tests/*.mjs text eol=lf
scripts/build-site-assets.mjs text eol=lf

# Windows resource files - preserve as-is (native Windows tooling)
*.rc -text
*.manifest -text

# Binary files
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
src/terminfo/testdata/* binary

#--------------------------------------------------------------------
# Linguist
#--------------------------------------------------------------------
build.zig.zon.nix linguist-generated=true
build.zig.zon.txt linguist-generated=true
build.zig.zon.json linguist-generated=true
vendor/** linguist-vendored
website/** linguist-documentation
pkg/breakpad/vendor/** linguist-vendored
pkg/glfw/wayland-headers/** linguist-vendored
pkg/libintl/config.h linguist-generated=true
pkg/libintl/libintl.h linguist-generated=true
pkg/simdutf/vendor/** linguist-vendored
src/font/nerd_font_tables.zig linguist-generated=true
src/font/nerd_font_codepoint_tables.py linguist-generated=true
src/font/res/** linguist-vendored
src/terminal/res/** linguist-vendored
