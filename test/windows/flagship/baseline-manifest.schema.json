{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://winghostty.dev/schemas/verification/baseline-manifest.v1.json",
  "title": "winghostty frozen baseline manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "captured_at", "git_commit", "platform", "artifacts"],
  "properties": {
    "schema_version": { "const": "winghostty.verification.baseline-manifest.v1" },
    "captured_at": { "type": "string", "format": "date-time" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "enum": ["x86_64", "aarch64"] },
        "description": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "kind": { "enum": ["executable", "contract", "session", "config", "screenshot", "uia", "trace", "transcript", "other"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "scenario_id": { "type": ["string", "null"] }
        }
      }
    }
  }
}
