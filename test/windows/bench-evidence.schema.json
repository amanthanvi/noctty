{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noctty.com/schemas/benchmark/windows-evidence.v1.json",
  "title": "noctty Windows benchmark evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "machine",
    "configuration",
    "target",
    "run_count",
    "processes",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "io.github.amanthanvi.noctty.bench-evidence.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["pass", "fail", "error", "not-installed", "not-supported"]
    },
    "machine": {
      "$ref": "#/definitions/machine"
    },
    "configuration": {
      "$ref": "#/definitions/configuration"
    },
    "target": {
      "$ref": "#/definitions/target"
    },
    "run_count": {
      "type": "integer",
      "minimum": 1
    },
    "processes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/process_record"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/metric"
      }
    }
  },
  "definitions": {
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_build",
        "cpu_model",
        "physical_cores",
        "logical_cores",
        "gpu_name",
        "gpu_driver_version",
        "display",
        "power_state"
      ],
      "properties": {
        "os_build": {
          "type": "string",
          "minLength": 1
        },
        "cpu_model": {
          "type": "string",
          "minLength": 1
        },
        "physical_cores": {
          "type": "integer",
          "minimum": 1
        },
        "logical_cores": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_name": {
          "type": "string",
          "minLength": 1
        },
        "gpu_driver_version": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "$ref": "#/definitions/display"
        },
        "power_state": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "refresh_hz", "dpi_scale_percent"],
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "refresh_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dpi_scale_percent": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font_family", "font_size_pt", "rows", "cols"],
      "properties": {
        "font_family": {
          "description": "Resolved installed font face used by the target.",
          "type": "string",
          "minLength": 1
        },
        "font_size_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "build_mode": {
          "description": "Optimization mode certified by the harness for a source-built target, otherwise null.",
          "enum": ["ReleaseFast", null]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "exe_path", "exe_sha256", "commit_sha"],
      "properties": {
        "name": {
          "enum": ["noctty", "alacritty", "windows-terminal", "tabby", "wave"]
        },
        "version": {
          "type": ["string", "null"]
        },
        "exe_path": {
          "type": ["string", "null"]
        },
        "exe_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "commit_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "process_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_name",
        "process_id",
        "started_at",
        "exe_path",
        "cleanup_method",
        "exit_confirmed",
        "exited_at"
      ],
      "properties": {
        "run_name": { "type": "string", "minLength": 1 },
        "process_id": { "type": "integer", "minimum": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "exe_path": { "type": "string", "minLength": 1 },
        "cleanup_method": { "type": "string", "minLength": 1 },
        "exit_confirmed": { "const": true },
        "exited_at": { "type": "string", "format": "date-time" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "status", "unit", "samples", "median", "p95"],
      "allOf": [
        {
          "if": {
            "required": ["status", "median"],
            "properties": {
              "status": { "enum": ["pass", "fail"] },
              "median": { "type": "number" }
            }
          },
          "then": {
            "required": ["threshold"]
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": {
                "enum": [
                  "throughput_mb_s",
                  "throughput_alt_screen_mb_s",
                  "scroll_mb_s"
                ]
              },
              "status": { "enum": ["pass", "fail", "error"] }
            }
          },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "required": [
                  "workload",
                  "bytes",
                  "producer",
                  "process_startup_included",
                  "endpoint",
                  "completion_signal",
                  "conpty_original_input_bytes_expected_to_be_preserved",
                  "downstream_backpressure_included",
                  "render_trace_snapshot_request_observer_included",
                  "render_trace_target_observer_included",
                  "terminal_visible_marker_observer_included",
                  "termio_trace_observer_included",
                  "windows_read_buffer_kib",
                  "diagnostic_profile_scope"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": { "const": "throughput_alt_screen_mb_s" },
              "status": { "enum": ["pass", "fail", "error"] }
            }
          },
          "then": {
            "properties": {
              "details": {
                "properties": {
                  "terminal_visible_marker_observer_included": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": { "enum": ["throughput_mb_s", "scroll_mb_s"] },
              "status": { "enum": ["pass", "fail", "error"] }
            }
          },
          "then": {
            "properties": {
              "details": {
                "properties": {
                  "terminal_visible_marker_observer_included": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status", "details"],
            "properties": {
              "metric": {
                "enum": [
                  "throughput_mb_s",
                  "throughput_alt_screen_mb_s",
                  "scroll_mb_s"
                ]
              },
              "status": { "const": "pass" },
              "details": {
                "required": ["termio_trace_observer_included"],
                "properties": {
                  "termio_trace_observer_included": { "const": true }
                }
              }
            }
          },
          "then": {
            "properties": {
              "details": {
                "required": ["diagnostic_profiles", "diagnostic_profile_scope"],
                "properties": {
                  "diagnostic_profile_scope": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": {
                "const": "cold_start_harness_ms"
              },
              "status": { "enum": ["pass", "fail", "error"] }
            }
          },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "required": ["process_creation_overhead_included"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": {
                "const": "cold_start_app_ms"
              },
              "status": { "enum": ["pass", "fail", "error"] }
            }
          },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "required": ["app_trace_field"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": {
                "const": "memory_bytes_per_additional_pane"
              },
              "status": { "enum": ["pass", "fail", "error"] }
            }
          },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "required": [
                  "shell_child_memory_included",
                  "additional_panes",
                  "memory_cycle_count",
                  "memory_diagnostic_only",
                  "memory_trace_token_scope"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": {
                "const": "memory_bytes_per_additional_pane"
              },
              "status": { "enum": ["pass", "fail"] }
            }
          },
          "then": {
            "properties": {
              "details": {
                "required": [
                  "private_memory_scope",
                  "graphics_context_model",
                  "memory_stage_observer_included",
                  "memory_stage_observation_scope",
                  "pane_close_action",
                  "destroy_settle_seconds",
                  "pane_lifecycle_samples"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": {
                "enum": [
                  "idle_cpu_percent",
                  "idle_gpu_percent",
                  "idle_swap_count_delta"
                ]
              },
              "status": { "enum": ["pass", "fail", "error"] }
            }
          },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "required": ["idle_interval_seconds"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": {
                "enum": [
                  "idle_cpu_percent",
                  "idle_gpu_percent",
                  "idle_swap_count_delta"
                ]
              },
              "status": { "enum": ["pass", "fail"] }
            }
          },
          "then": {
            "properties": {
              "details": {
                "required": [
                  "cursor_blinking",
                  "idle_quiescence_requirement_ms",
                  "render_trace_counter_deltas"
                ],
                "properties": {
                  "cursor_blinking": { "const": false },
                  "idle_quiescence_requirement_ms": { "minimum": 1200 }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": {
                "const": "conpty_rtt_ms"
              },
              "status": { "enum": ["pass", "fail", "error"] }
            }
          },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "required": ["endpoint", "clock"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": {
                "const": "key_to_first_swap_ms_proxy"
              },
              "status": { "enum": ["pass", "fail", "error"] }
            }
          },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "required": [
                  "proxy_kind",
                  "render_trace_path",
                  "render_trace_target_observer_included"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["metric", "status"],
            "properties": {
              "metric": {
                "const": "frame_time_p95_ms"
              },
              "status": { "enum": ["pass", "fail", "error"] }
            }
          },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "required": [
                  "workload",
                  "endpoint",
                  "clock",
                  "aggregation",
                  "software_observation",
                  "compositor_scanout_included",
                  "photon_measurement"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "const": "not-supported" }
            }
          },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "required": [
                  "adapter_requirement",
                  "comparability_requirement",
                  "required_tooling"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "metric": {
          "enum": [
            "throughput_mb_s",
            "throughput_alt_screen_mb_s",
            "scroll_mb_s",
            "cold_start_harness_ms",
            "cold_start_app_ms",
            "memory_bytes_per_additional_pane",
            "idle_cpu_percent",
            "idle_gpu_percent",
            "idle_swap_count_delta",
            "conpty_rtt_ms",
            "key_to_first_swap_ms_proxy",
            "frame_time_p95_ms"
          ]
        },
        "status": {
          "enum": ["pass", "fail", "error", "skip", "not-supported"]
        },
        "unit": {
          "enum": ["MB/s", "ms", "bytes", "percent", "count"]
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "median": {
          "type": ["number", "null"]
        },
        "p95": {
          "type": ["number", "null"]
        },
        "threshold": {
          "$ref": "#/definitions/threshold_result"
        },
        "details": {
          "$ref": "#/definitions/metric_details"
        }
      }
    },
    "threshold_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "value",
        "active",
        "provisional",
        "source",
        "passed"
      ],
      "properties": {
        "direction": {
          "enum": ["min", "max", "minimum", "maximum", "at-least", "at-most"]
        },
        "value": {
          "type": "number"
        },
        "active": {
          "type": "boolean"
        },
        "provisional": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": ["boolean", "null"]
        }
      }
    },
    "metric_details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workload": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "process_startup_included": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "completion_signal": {
          "type": "string",
          "minLength": 1
        },
        "conpty_original_input_bytes_expected_to_be_preserved": {
          "type": "boolean"
        },
        "downstream_backpressure_included": {
          "type": "boolean"
        },
        "render_trace_snapshot_request_observer_included": {
          "type": "boolean"
        },
        "render_trace_target_observer_included": {
          "type": "boolean"
        },
        "terminal_visible_marker_observer_included": {
          "type": "boolean"
        },
        "termio_trace_observer_included": {
          "type": "boolean"
        },
        "windows_read_buffer_kib": {
          "type": "integer",
          "const": 64
        },
        "diagnostic_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/termio_diagnostic_profile"
          }
        },
        "diagnostic_profile_scope": {
          "type": ["string", "null"]
        },
        "process_creation_overhead_included": {
          "type": "boolean"
        },
        "trace_file_polling_included": {
          "type": "boolean"
        },
        "app_trace_field": {
          "type": "string",
          "minLength": 1
        },
        "clock_origin": {
          "type": "string",
          "minLength": 1
        },
        "shell_child_memory_included": {
          "type": "boolean"
        },
        "additional_panes": {
          "const": 3
        },
        "memory_cycle_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "memory_diagnostic_only": {
          "type": "boolean"
        },
        "memory_trace_token_scope": {
          "const": "surface_begin_incarnation"
        },
        "private_memory_scope": {
          "type": "string",
          "minLength": 1
        },
        "graphics_context_model": {
          "type": "string",
          "minLength": 1
        },
        "memory_stage_observer_included": {
          "const": true
        },
        "memory_stage_observation_scope": {
          "type": "string",
          "minLength": 1
        },
        "pane_close_action": {
          "type": "string",
          "minLength": 1
        },
        "destroy_settle_seconds": {
          "type": "number",
          "minimum": 0
        },
        "pane_lifecycle_samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/pane_lifecycle_sample"
          }
        },
        "idle_interval_seconds": {
          "type": "number",
          "minimum": 10
        },
        "cursor_blinking": {
          "type": "boolean"
        },
        "idle_quiescence_requirement_ms": {
          "type": "number",
          "minimum": 1200
        },
        "render_trace_counter_deltas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/idle_render_trace_counter_delta"
          }
        },
        "proxy_kind": {
          "type": "string",
          "minLength": 1
        },
        "clock": {
          "type": "string",
          "minLength": 1
        },
        "aggregation": {
          "type": "string",
          "minLength": 1
        },
        "software_observation": {
          "type": "boolean"
        },
        "compositor_scanout_included": {
          "type": "boolean"
        },
        "adapter_requirement": {
          "type": "string",
          "minLength": 1
        },
        "comparability_requirement": {
          "type": "string",
          "minLength": 1
        },
        "required_tooling": {
          "type": "string",
          "minLength": 1
        },
        "uia_nonce_validation": {
          "type": "boolean"
        },
        "excludes_post_swap_trace_observation_delay": {
          "type": "boolean"
        },
        "photon_measurement": {
          "type": "boolean"
        },
        "render_trace_path": {
          "type": ["string", "null"]
        },
        "observation_method": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["memory_cycle_count"],
            "properties": { "memory_cycle_count": { "minimum": 2 } }
          },
          "then": {
            "properties": { "memory_diagnostic_only": { "const": true } }
          }
        },
        {
          "if": {
            "required": ["memory_cycle_count"],
            "properties": { "memory_cycle_count": { "const": 1 } }
          },
          "then": {
            "properties": { "memory_diagnostic_only": { "const": false } }
          }
        }
      ]
    },
    "termio_diagnostic_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows_pty_read_buffer_bytes",
        "windows_pty_read_count",
        "windows_pty_read_bytes",
        "windows_pty_read_le_4k_count",
        "windows_pty_read_le_16k_count",
        "windows_pty_read_le_64k_count",
        "windows_pty_read_gt_64k_count",
        "windows_read_file_total_ns",
        "windows_read_file_max_ns",
        "windows_process_output_total_ns",
        "windows_process_output_max_ns",
        "renderer_mutex_wait_total_ns",
        "renderer_mutex_wait_max_ns",
        "renderer_mutex_hold_total_ns",
        "renderer_mutex_hold_max_ns"
      ],
      "properties": {
        "windows_pty_read_buffer_bytes": {
          "type": "integer",
          "minimum": 16384
        },
        "windows_pty_read_count": { "type": "integer", "minimum": 1 },
        "windows_pty_read_bytes": { "type": "integer", "minimum": 1 },
        "windows_pty_read_le_4k_count": { "type": "integer", "minimum": 0 },
        "windows_pty_read_le_16k_count": { "type": "integer", "minimum": 0 },
        "windows_pty_read_le_64k_count": { "type": "integer", "minimum": 0 },
        "windows_pty_read_gt_64k_count": { "type": "integer", "minimum": 0 },
        "windows_read_file_total_ns": { "type": "integer", "minimum": 0 },
        "windows_read_file_max_ns": { "type": "integer", "minimum": 0 },
        "windows_process_output_total_ns": { "type": "integer", "minimum": 0 },
        "windows_process_output_max_ns": { "type": "integer", "minimum": 0 },
        "renderer_mutex_wait_total_ns": { "type": "integer", "minimum": 0 },
        "renderer_mutex_wait_max_ns": { "type": "integer", "minimum": 0 },
        "renderer_mutex_hold_total_ns": { "type": "integer", "minimum": 0 },
        "renderer_mutex_hold_max_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "pane_lifecycle_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "cycle",
        "baseline_private_bytes",
        "live_private_bytes",
        "private_bytes_after_each_pane",
        "marginal_private_bytes",
        "private_bytes_after_logical_close",
        "private_bytes_after_destroy_settle",
        "reclaimed_private_bytes_after_destroy_settle",
        "retained_private_bytes_above_baseline_after_destroy_settle",
        "pane_count_at_baseline",
        "pane_count_after_each_create",
        "pane_count_after_each_close",
        "pane_count_after_close",
        "pane_count_after_destroy_settle",
        "destroy_settle_seconds",
        "baseline_surface_ids",
        "survivor_surface_ids_after_each_close",
        "survivor_surface_ids_after_destroy_settle",
        "created_surface_ids",
        "created_surface_count",
        "memory_stage_samples"
      ],
      "properties": {
        "run": { "type": "integer", "minimum": 1 },
        "cycle": { "type": "integer", "minimum": 1, "maximum": 5 },
        "baseline_private_bytes": { "type": "number", "minimum": 0 },
        "live_private_bytes": { "type": "number", "minimum": 0 },
        "private_bytes_after_each_pane": {
          "type": "array",
          "minItems": 3,
