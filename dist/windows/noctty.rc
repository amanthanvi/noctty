// LANG_NEUTRAL(0), SUBLANG_NEUTRAL(0)
LANGUAGE 0, 0

#define RT_MANIFEST 1
RT_MANIFEST 24 "noctty.manifest"

#define ID_ICON_GHOSTTY 1
// GhosttyExe.zig passes an icon-content hash define so .ico-only changes
// invalidate Zig's cached resource compilation.
ID_ICON_GHOSTTY ICON "noctty.ico"

// Version defines come from GhosttyExe.zig and are part of the resource cache key.
// These defaults also allow standalone resource compilation.
#ifndef NOCTTY_VERSION_MAJOR
#define NOCTTY_VERSION_MAJOR 0
#define NOCTTY_VERSION_MINOR 0
#define NOCTTY_VERSION_PATCH 0
#define NOCTTY_VERSION_STRING "0.0.0-dev"
#endif

// Standard VS_VERSION_INFO resource ID (1), not a string-named resource.
1 VERSIONINFO
FILEVERSION     NOCTTY_VERSION_MAJOR,NOCTTY_VERSION_MINOR,NOCTTY_VERSION_PATCH,0
PRODUCTVERSION  NOCTTY_VERSION_MAJOR,NOCTTY_VERSION_MINOR,NOCTTY_VERSION_PATCH,0
FILEFLAGSMASK   0x3f
FILEFLAGS      0
FILEOS         0x40004 // VOS_NT_WINDOWS32
FILETYPE       1 // VFT_APP
FILESUBTYPE    0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
        //VALUE "CompanyName",        "???"
        VALUE "FileDescription",    "noctty"
        VALUE "FileVersion",        NOCTTY_VERSION_STRING
        //VALUE "LegalCopyright",     "(C) 2024 ???"
        VALUE "OriginalFilename", "noctty.exe"
        VALUE "ProductName",        "noctty"
        VALUE "ProductVersion",     NOCTTY_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409,1200
    END
END
